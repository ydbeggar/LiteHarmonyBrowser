{
  "app": {
    "bundleName": "com.example.litewearbrowser",
    "vendor": "example",
    "version": {
      "code": 1103,
      "name": "1.1.3"
    },
    "apiVersion": {
      "compatible": 60100023,
      "target": 60100023,
      "releaseType": "Release"
    }
  },
  "deviceConfig": {
    "default": {}
  },
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:app_desc",
        "label": "$string:app_name",
        "type": "page"
      }
    ],
    "js": [
      {
        "name": ".MainAbility",
        "pages": [
          "pages/index/index",
          "pages/reader/reader",
          "pages/links/links",
          "pages/shelf/shelf",
          "pages/settings/settings",
          "pages/search/search",
          "pages/offline/offline",
          "pages/novel/novel",
          "pages/ai/ai",
          "pages/rss/rss",
          "pages/round/reader/reader",
          "pages/round/links/links",
          "pages/round/shelf/shelf",
          "pages/round/settings/settings",
          "pages/round/search/search",
          "pages/round/offline/offline",
          "pages/round/novel/novel",
          "pages/round/ai/ai",
          "pages/round/rss/rss"
        ]
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:reqPermissions",
        "usedScene": {
          "ability": [
            "MainAbility"
          ],
          "when": "always"
        }
      }
    ]
  }
}
