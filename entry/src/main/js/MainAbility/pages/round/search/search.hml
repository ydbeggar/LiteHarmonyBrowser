<stack class="rd-root" onswipe="onSwipe" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <stack class="rd-view" if="{{isDetail}}">
        <stack class="rd-detail">
            <text class="rd-d-title">{{current.title}}</text>
            <text class="rd-d-sub">{{current.sub}}</text>
            <list class="rd-d-sum-list" ref="sumList" id="sumList" rotationvibrate="true">
                <list-item class="rd-d-sum-item" style="height: {{sumItemHeight}}px;">
                    <text class="rd-d-summary" style="height: {{sumHeight}}px;">{{current.summary}}</text>
                </list-item>
            </list>
            <text class="rd-d-url">{{current.url}}</text>
            <div class="rd-d-foot">
                <div class="rd-btn rd-primary" onclick="onVisit">
                    <text class="rd-btn-txt">访问</text>
                </div>
                <div class="rd-btn" onclick="onBackToList">
                    <text class="rd-btn-txt">返回</text>
                </div>
            </div>
        </stack>
        <image class="rd-mask-top" src="/common/round_mask_top.png"></image>
        <image class="rd-mask-bottom" src="/common/round_mask_bottom.png"></image>
        <div class="rd-hdr">
            <div class="rd-hdr-btn" onclick="onHdrBack">
                <image class="rd-hdr-back" src="/common/ic_back.png"></image>
            </div>
            <text class="rd-hdr-title">{{headerTitle}}</text>
            <div class="rd-hdr-btn" onclick="onStar">
                <image class="rd-star" src="{{starIcon}}"></image>
            </div>
        </div>
    </stack>

    <stack class="rd-view" elif="{{isList}}">
        <stack class="rd-s-list">
            <div class="rd-bar">
                <input class="rd-bar-input" type="text" placeholder="输入关键词"
                       onchange="onQueryChange" />
                <div class="rd-bar-btn" onclick="onSearch">
                    <text class="rd-bar-btn-txt">搜索</text>
                </div>
            </div>

            <stack class="rd-area">
                <div class="rd-state lwb-in" if="{{isLoading}}">
                    <stack class="rd-spin">
                        <stack class="rd-sway" style="left: {{swayLeft}}px;">
                            <image class="rd-sway-img" src="/common/ic_search.png"></image>
                        </stack>
                    </stack>
                    <text class="rd-state-title">正在搜索…</text>
                    <text class="rd-state-sub">{{query}}</text>
                </div>

                <list class="rd-list" ref="resultList" id="resultList" rotationvibrate="true"
                      elif="{{hasResults}}" style="opacity: {{fadeOpacity}};">
                    <list-item class="rd-spacer-item">
                        <div class="rd-spacer"></div>
                    </list-item>
                    <list-item class="rd-item" for="{{(index, item) in items}}" tid="url">
                        <stack class="rd-item-inner" onclick="onOpen(index)">
                            <text class="rd-item-title">{{item.title}}</text>
                            <text class="rd-item-sub">{{item.sub}}</text>
                            <text class="rd-item-arrow">›</text>
                        </stack>
                    </list-item>
                    <list-item class="rd-tail-item">
                        <div class="rd-tail"></div>
                    </list-item>
                </list>

                <div class="rd-state lwb-in" elif="{{isFailed}}">
                    <text class="rd-state-title">{{failTitle}}</text>
                    <text class="rd-state-sub">{{failSub}}</text>
                    <div class="rd-act-row">
                        <div class="rd-act-btn" onclick="onSearch">
                            <text class="rd-act-txt">重试</text>
                        </div>
                        <div class="rd-act-btn rd-ghost" onclick="onBack">
                            <text class="rd-act-txt">返回首页</text>
                        </div>
                    </div>
                </div>

                <div class="rd-state lwb-in" else>
                    <text class="rd-state-title">{{emptyTitle}}</text>
                    <text class="rd-state-sub">换个关键词试试</text>
                </div>
            </stack>
        </stack>
        <image class="rd-mask-top" src="/common/round_mask_top.png"></image>
        <image class="rd-mask-bottom" src="/common/round_mask_bottom.png"></image>
        <div class="rd-hdr">
            <div class="rd-hdr-btn" onclick="onHdrBack">
                <image class="rd-hdr-back" src="/common/ic_back.png"></image>
            </div>
            <text class="rd-hdr-title">{{headerTitle}}</text>
            <div class="rd-hdr-btn rd-hdr-btn-flat"></div>
        </div>
    </stack>
</stack>
